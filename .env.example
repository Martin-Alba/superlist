# Neon: copia este archivo a .env.local y rellena los valores del dashboard de Neon.
# Usa sslmode=verify-full: pg avisa de que "require" cambiará de significado en pg v9.

# Conexión "pooled" (host con -pooler): la usa la app en runtime.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=verify-full"

# Conexión directa (sin -pooler): la usa drizzle-kit para migrar.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=verify-full"

# Better Auth
# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
# En Vercel lo configuras tú en Project Settings > Environment Variables (Production y Preview).
BETTER_AUTH_SECRET="cambia-esto"

# Solo en local. En Vercel la URL base y los orígenes permitidos salen de las variables de sistema
# VERCEL_ENV, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL y VERCEL_BRANCH_URL
# (requiere "Automatically expose System Environment Variables" activado en el proyecto).
BETTER_AUTH_URL="http://localhost:3000"
